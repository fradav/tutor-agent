# Template provider config — install.sh copies this to <prefix>/harn/providers.toml,
# inside the installation prefix. The harn runtime is pointed at that file with
# the HARN_PROVIDERS_CONFIG environment variable (run.sh sets it to the file next
# to it; env.example.sh exports the same path). Nothing is written to the home
# config directory. If HARN_PROVIDERS_CONFIG is unset, harn falls back to
# ~/.config/harn/providers.toml.
#
# NEVER commit your real providers.toml — it may contain credentials.

# Local router (llama.cpp mode "router", any OpenAI-compatible server).
# No authentication; this is the fallback-friendly default provider.
[providers.llamacpp]
base_url = "http://127.0.0.1:8025/v1"
auth_style = "none"
chat_endpoint = "/chat/completions"

# Optional remote fallback endpoint.
# - auth_style "bearer" sends: Authorization: Bearer <auth_env value>
# - auth_env may be a single variable name, or an array of names tried in order.
# Set TUTOR_API_KEY in the environment (not committed anywhere) and
# TUTOR_FALLBACK=llamacpp_remote to use this provider automatically when the
# local router is unavailable.
[providers.llamacpp_remote]
base_url = "https://your-remote-endpoint.example/v1"
auth_style = "bearer"
auth_env = "TUTOR_API_KEY"
chat_endpoint = "/chat/completions"
